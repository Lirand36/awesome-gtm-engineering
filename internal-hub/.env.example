# Copy to .env and fill in. Any system left empty runs in MOCK mode:
# the request is built exactly as it would be sent, logged, and answered with a fake response.

PORT=3000

# HubSpot — Private App access token (scopes: crm.objects.deals.write, crm.objects.contacts.write)
HUBSPOT_TOKEN=

# Jira Cloud — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=            # e.g. https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP

# Intercom — Access token from Developer Hub + the admin id replies are sent as
INTERCOM_TOKEN=
INTERCOM_ADMIN_ID=

# Generic outbound webhook (Slack incoming webhook, Zapier, Make, n8n, internal service...)
OUTBOUND_WEBHOOK_URL=
